<Window x:Class="WinterTray.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinterTray - Settings"
        Height="820" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#1F1F1F"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#292929" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#383838" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#60CDFF" />
            <Setter Property="Margin" Value="4,12,0,8" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#60CDFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A88D9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FEJLÉC -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Name="BtnFeedback" DockPanel.Dock="Right" Content="💬 Feedback &amp; Bugs" Style="{StaticResource StandardButton}" 
                    VerticalAlignment="Center" Click="OnFeedbackClicked" Cursor="Hand" ToolTip="Open feedback and bug report form" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Name="TxtHeaderIcon" Text="❄" FontSize="26" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WinterTray" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Name="TxtHeaderDesc" Text="Winter snowfall and autumn leaves on your desktop" FontSize="12" Foreground="#AAAAAA" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- ÉVSZAK ÉS NYELV VÁLASZTÓ KÁRTYÁK -->
                <TextBlock Name="TxtSecSeason" Text="SEASON, THEME &amp; LANGUAGE" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingCard}" Background="#242B35" BorderBrush="#3B485A">
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Name="TxtSeasonTitle" Text="Current season" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" />
                            <TextBlock Name="TxtSeasonSub" Text="Switch instantly between winter snowfall and autumn leaves" FontSize="11" Foreground="#9BA5B5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton Name="RbSeasonWinter" Content="❄ Winter" GroupName="SeasonGroup" 
                                         FontWeight="SemiBold" Foreground="#60CDFF" Margin="0,0,18,0" Checked="OnSeasonChanged" />
                            <RadioButton Name="RbSeasonAutumn" Content="🍂 Autumn" GroupName="SeasonGroup" 
                                         FontWeight="SemiBold" Foreground="#FFA726" Checked="OnSeasonChanged" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}" Background="#242B35" BorderBrush="#3B485A">
                    <DockPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Name="TxtLangTitle" Text="Language" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="14" />
                            <TextBlock Name="TxtLangSub" Text="Select the application interface language" FontSize="11" Foreground="#9BA5B5" />
                        </StackPanel>
                        <ComboBox Name="CmbLanguage" Width="160" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Name="CmbLangEn" Content="English" IsSelected="True" />
                            <ComboBoxItem Name="CmbLangHu" Content="Magyar" />
                        </ComboBox>
                    </DockPanel>
                </Border>

                <!-- ==================== TÉLI BEÁLLÍTÁSOK ==================== -->
                <StackPanel Name="PanelWinter">
                    <TextBlock Name="TxtSecWinterVisual" Text="❄ WINTER SNOWFALL &amp; APPEARANCE" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SettingCard}">
                        <DockPanel>
                            <TextBlock Name="TxtFlakeStyleLabel" Text="Snowflake style" VerticalAlignment="Center" Foreground="#E0E0E0" FontWeight="Medium" />
                            <ComboBox Name="CmbStyle" Width="200" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Name="CmbStyleMixed" Content="Mixed (crystals + fluffy)" IsSelected="True" />
                                <ComboBoxItem Name="CmbStyleFluffy" Content="Soft, fluffy flakes" />
                                <ComboBoxItem Name="CmbStyleCrystal" Content="Detailed ice crystals" />
                            </ComboBox>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtFlakeCountLabel" Text="Snowflake count" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtFlakeCount" Text="200" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderFlakeCount" Minimum="30" Maximum="500" SmallChange="10" LargeChange="50" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtFallSpeedLabel" Text="Fall speed" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtFallSpeed" Text="1.0x" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderFallSpeed" Minimum="0.3" Maximum="2.5" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtWindLabel" Text="Natural wind (negative = left)" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtWind" Text="0.3" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderWind" Minimum="-1.5" Maximum="1.5" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtSizeLabel" Text="Snowflake size" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtSize" Text="2.3 - 6.0 px" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderSize" Minimum="3" Maximum="10" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <TextBlock Name="TxtSecWinterWindows" Text="❄ SNOW ACCUMULATION &amp; WINDOWS" Style="{StaticResource SectionHeader}" />

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkAccumulate" Content="Snow accumulates on top of floating windows" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkSnowOverhang" Content="Snow gently overhangs the window title bar (2-4 px soft edge)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkShowIcicles" Content="Icicles on window tops and bottoms (click to shatter!)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtIcicleDensityLabel" Text="Icicle density" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtIcicleDensity" Text="1.0x" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderIcicleDensity" Minimum="0.4" Maximum="2.0" SmallChange="0.1" LargeChange="0.2" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkTaskbar" Content="Snow also accumulates on the taskbar (otherwise disappears behind it)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtAccumLabel" Text="Accumulation speed" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtAccum" Text="0.20x" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderAccum" Minimum="0.05" Maximum="2.0" SmallChange="0.05" LargeChange="0.2" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Name="TxtMaxHeightLabel" Text="Maximum snow thickness" Foreground="#E0E0E0" FontWeight="Medium" VerticalAlignment="Center" />
                                <TextBlock Name="TxtMaxHeight" Text="22 px" Foreground="#60CDFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <CheckBox Name="ChkLimitMaxHeight" Content="Limit thickness (when unchecked, snow can grow infinitely)" 
                                      Margin="0,0,0,6" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                            <Slider Name="SliderMaxHeight" Minimum="6" Maximum="60" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkFallOff" Content="Snow falls off when a window is moved, closed, or minimized" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>
                </StackPanel>

                <!-- ==================== ŐSZI BEÁLLÍTÁSOK ==================== -->
                <StackPanel Name="PanelAutumn" Visibility="Collapsed">
                    <TextBlock Name="TxtSecAutumnRain" Text="🍂 AUTUMN RAIN &amp; SPLASHES" Style="{StaticResource SectionHeader}" Foreground="#60CDFF" />

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkRain" Content="Enable autumn rain (realistic rain streaks and splashes on windows)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtRainCountLabel" Text="Raindrop count" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtRainCount" Text="220" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderRainCount" Minimum="40" Maximum="450" SmallChange="10" LargeChange="50" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtRainSpeedLabel" Text="Rain fall speed" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtRainSpeed" Text="1.0x" Foreground="#60CDFF" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderRainSpeed" Minimum="0.5" Maximum="2.0" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <TextBlock Name="TxtSecAutumnLeaves" Text="🍂 AUTUMN LEAVES &amp; WINDOWS" Style="{StaticResource SectionHeader}" Foreground="#FFA726" />

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtLeafCountLabel" Text="Falling leaves count (sparse, gentle fall)" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtLeafCount" Text="7" Foreground="#FFA726" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderLeafCount" Minimum="1" Maximum="25" SmallChange="1" LargeChange="5" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtLeafSpeedLabel" Text="Leaf fall speed" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtLeafSpeed" Text="0.9x" Foreground="#FFA726" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderLeafSpeed" Minimum="0.3" Maximum="2.5" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtLeafWindLabel" Text="Natural wind (negative = left)" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtLeafWind" Text="0.3" Foreground="#FFA726" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderLeafWind" Minimum="-1.5" Maximum="1.5" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtLeafSizeLabel" Text="Leaf size" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtLeafSize" Text="18 px" Foreground="#FFA726" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderLeafSize" Minimum="12" Maximum="32" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkLeafAccumulate" Content="Leaves rest on top of floating windows" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <CheckBox Name="ChkLeafTaskbar" Content="Leaves and rain also land/splash on the taskbar (otherwise fall behind it)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Name="TxtLeafLifeLabel" Text="Rested leaf lifetime (0 = never disappears)" Foreground="#E0E0E0" FontWeight="Medium" />
                                <TextBlock Name="TxtLeafLife" Text="120 s (2 min)" Foreground="#FFA726" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider Name="SliderLeafLife" Minimum="0" Maximum="300" SmallChange="10" LargeChange="30" ValueChanged="OnSettingChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== EGÉR ÉS INTERAKCIÓ ==================== -->
                <TextBlock Name="TxtSecMouse" Text="MOUSE CURSOR &amp; INTERACTION" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource SettingCard}">
                    <CheckBox Name="ChkMouseRepel" Content="Mouse cursor blows away falling particles (wind vortex)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Name="TxtMousePowerLabel" Text="Wind power" Foreground="#E0E0E0" FontWeight="Medium" />
                            <TextBlock Name="TxtMousePower" Text="1.0x" Foreground="#60CDFF" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Name="SliderMousePower" Minimum="0.2" Maximum="3.0" ValueChanged="OnSettingChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Name="TxtMouseSensLabel" Text="Speed sensitivity (faster mouse = stronger effect)" Foreground="#E0E0E0" FontWeight="Medium" />
                            <TextBlock Name="TxtMouseSens" Text="1.0x" Foreground="#60CDFF" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Name="SliderMouseSens" Minimum="0.0" Maximum="3.0" ValueChanged="OnSettingChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Name="TxtMouseRadiusLabel" Text="Base effect radius" Foreground="#E0E0E0" FontWeight="Medium" />
                            <TextBlock Name="TxtMouseRadius" Text="90 px" Foreground="#60CDFF" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider Name="SliderMouseRadius" Minimum="40" Maximum="250" ValueChanged="OnSettingChanged" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <CheckBox Name="ChkSweep" Content="Sweep snow and blow leaves off windows with the mouse cursor" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                </Border>

                <!-- ==================== TELJESÍTMÉNY ÉS RENDSZER ==================== -->
                <TextBlock Name="TxtSecSystem" Text="PERFORMANCE &amp; SYSTEM" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource SettingCard}">
                    <DockPanel>
                        <TextBlock Name="TxtFpsLabel" Text="Frame rate (FPS)" VerticalAlignment="Center" Foreground="#E0E0E0" FontWeight="Medium" />
                        <ComboBox Name="CmbFps" Width="240" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Name="CmbFpsNative" Content="Monitor Native (VSync / 120+ FPS)" IsSelected="True" />
                            <ComboBoxItem Name="CmbFps120" Content="120 FPS (Super smooth)" />
                            <ComboBoxItem Name="CmbFps60" Content="60 FPS (Default)" />
                            <ComboBoxItem Name="CmbFps30" Content="30 FPS (Power saving)" />
                        </ComboBox>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <DockPanel>
                        <TextBlock Name="TxtAnimQualityLabel" Text="Effects &amp; animation quality" VerticalAlignment="Center" Foreground="#E0E0E0" FontWeight="Medium" />
                        <ComboBox Name="CmbAnimQuality" Width="240" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged">
                            <ComboBoxItem Name="CmbQualityUltra" Content="Full / Ultra (120 FPS smooth particles)" IsSelected="True" />
                            <ComboBoxItem Name="CmbQualityMed" Content="Medium (Balanced)" />
                            <ComboBoxItem Name="CmbQualityLow" Content="Off (Low-end PCs)" />
                        </ComboBox>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <CheckBox Name="ChkPauseCovered" Content="Pause when windows completely cover the desktop (zero load)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <CheckBox Name="ChkAutoStart" Content="Start automatically with Windows" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <CheckBox Name="ChkUseWallpaper" Content="Set seasonal desktop wallpaper (Winter: wallpaper.jpeg, Autumn: wallpaper-fall.jpeg)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- LÁBLÉC GOMBOK -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,10,0,0" BorderBrush="#383838" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Name="BtnClear" Content="Clear snow" Style="{StaticResource StandardButton}" Click="OnClearClicked" Margin="0,0,8,0" />
                <Button Name="BtnReset" Content="Reset defaults" Style="{StaticResource StandardButton}" Click="OnResetDefaultsClicked" Margin="0,0,8,0" />
                <Button Name="BtnSave" Content="Save &amp; Close" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Click="OnSaveClicked" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
