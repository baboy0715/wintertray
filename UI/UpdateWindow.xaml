<Window x:Class="WinterTray.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinterTray - Update"
        Height="460" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1F1F1F"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A88D9" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555" />
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#444444" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2A" />
                    <Setter Property="Foreground" Value="#666666" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#60CDFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border Name="PART_Track" />
                            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FEJLÉC -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="❄" FontSize="32" Foreground="#60CDFF" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Name="TxtTitle" Text="Új frissítés érhető el! 🚀" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Name="TxtVersionCompare" Text="WinterTray v2.3.0 (Jelenlegi verzió: v2.2.0)" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- VÁLTOZÁSOK / RELEASE NOTES KÁRTYA -->
        <Border Grid.Row="1" Background="#292929" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Name="TxtChangelogTitle" DockPanel.Dock="Top" Text="Változások és újdonságok:" FontWeight="SemiBold" FontSize="13" Foreground="#60CDFF" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Name="TxtChangelog" Text="Az új verzió letölthető és telepíthető." TextWrapping="Wrap" FontSize="12" Foreground="#D0D0D0" LineHeight="18" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- LETÖLTÉSI FOLYAMAT / STÁTUSZ -->
        <StackPanel Grid.Row="2" Name="PanelProgress" Visibility="Collapsed" Margin="0,0,0,14">
            <DockPanel Margin="0,0,0,6">
                <TextBlock Name="TxtProgressStatus" Text="Letöltés folyamatban..." FontSize="12" Foreground="#E0E0E0" />
                <TextBlock Name="TxtProgressPercent" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF" HorizontalAlignment="Right" />
            </DockPanel>
            <ProgressBar Name="PbDownload" Minimum="0" Maximum="100" Value="0" />
        </StackPanel>

        <!-- LÁBLÉC GOMBOK -->
        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <Button Name="BtnCancel" DockPanel.Dock="Left" Content="Később" Style="{StaticResource StandardButton}" Click="OnCancelClicked" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnBrowser" Content="🌐 Megnyitás böngészőben" Style="{StaticResource StandardButton}" Margin="0,0,8,0" Click="OnBrowserClicked" />
                <Button Name="BtnDownload" Content="⚡ Letöltés és Telepítés" Style="{StaticResource AccentButton}" Click="OnDownloadClicked" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
